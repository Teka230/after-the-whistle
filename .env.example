# SQLite database path (default: ./data/after-the-whistle.db)
AFTER_THE_WHISTLE_DB_PATH=./data/after-the-whistle.db
# Legacy alias (still supported)
# DEBRIEF_DB_PATH=./data/debrief.db

# API-Football (https://www.api-football.com) — free tier 100 req/day
API_FOOTBALL_KEY=

# Optional: HTTP proxy for stats.nba.com if rate-limited
NBA_STATS_PROXY=

# MCP server (keep 8788 — Project Harness uses PORT=8787)
MCP_PORT=8788
MCP_HOST=127.0.0.1

# Tailscale Funnel on the SAME hostname as Project Harness (path /whistle → :8788).
# Required for public ChatGPT URL; leave empty for local-only dev on /mcp.
MCP_BASE_PATH=/whistle
TAILSCALE_HOST=macbook-pro-m2-de-teka.tailda6e2e.ts.net
WHISTLE_FUNNEL_PATH=/whistle

# ChatGPT connector (with MCP_BASE_PATH=/whistle):
# https://<TAILSCALE_HOST>/whistle/mcp

# Live / on-demand ingest (show_game fetches NBA + API-Football automatically)
# API_FOOTBALL_KEY=your_key
# NBA_STATS_PROXY=          # optional proxy if stats.nba.com blocks you
# WHISTLE_AUTO_DEMO=1       # only if you want offline demo seed on empty DB
