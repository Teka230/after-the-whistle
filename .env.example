# SQLite database path (default: ./data/after-the-whistle.db)
AFTER_THE_WHISTLE_DB_PATH=./data/after-the-whistle.db
# Legacy alias (still supported)
# DEBRIEF_DB_PATH=./data/debrief.db

# Optional: HTTP proxy for stats.nba.com if rate-limited
NBA_STATS_PROXY=

# MCP server (keep 8788 — Project Harness uses PORT=8787)
MCP_PORT=8788
HOST=127.0.0.1
MCP_ALLOWED_HOSTS=

# Optional base path. Use /whistle for a hosted connector or local tunnel.
# Leave empty for local-only development at /mcp.
MCP_BASE_PATH=
# Only required when using the developer-only Tailscale Funnel scripts.
TAILSCALE_HOST=
WHISTLE_FUNNEL_PATH=/whistle

# Live / on-demand ingest (NBA and ESPN public endpoints)
# NBA_STATS_PROXY=          # optional proxy if stats.nba.com blocks you
# WHISTLE_AUTO_DEMO=1       # only if you want offline demo seed on empty DB
